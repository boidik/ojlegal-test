rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Direct token check SOLELY for advocate@boidikghosh.in (Sole Master Admin)
    function isMasterAdmin() {
      return isAuthenticated() && request.auth.token.email == 'advocate@boidikghosh.in';
    }
    
    // Safe lookup for user role in Firestore users collection
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : 'staff';
    }
    
    // Software Admin: Either verified master email OR software_admin role
    function isSoftwareAdmin() {
      return isAuthenticated() && (
        isMasterAdmin() || 
        getUserRole() == 'software_admin'
      );
    }
    
    // Accounts Admin: Boss or Software Admin
    function isAccountsAdmin() {
      return isAuthenticated() && (
        isSoftwareAdmin() || 
        getUserRole() == 'accounts_admin'
      );
    }

    // System configuration (Firm branding, currency, report layout)
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isSoftwareAdmin();
    }

    // Cases registry: Read by all authenticated users; modified by Software Admin & Accounts Admin
    match /cases/{caseId} {
      allow read: if isAuthenticated();
      allow write: if isAccountsAdmin();
    }

    // Expense Categories: Read by all authenticated users; modified by Software Admin
    match /categories/{catId} {
      allow read: if isAuthenticated();
      allow write: if isSoftwareAdmin();
    }

    // Court Forums: Read by all authenticated users; modified by Software Admin & Accounts Admin
    match /forums/{forumId} {
      allow read: if isAuthenticated();
      allow write: if isAccountsAdmin();
    }

    // Expenses:
    // - Authenticated staff can log expenses
    // - Boss and Software Admin can audit and modify all expenses
    // - Associates can edit or delete their own entries
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAccountsAdmin() || (isAuthenticated() && resource.data.staffId == request.auth.uid);
    }

    // Advances:
    // - Authenticated users can read advances (staff views their allocated float)
    // - Accounts Admin / Boss can disburse and delete advances
    // - Authenticated staff can update advance usage against their float
    match /advances/{advanceId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAccountsAdmin();
      allow update: if isAuthenticated();
    }

    // Users directory:
    // - Users can create and update their own auth profile
    // - Master Admin and Software Admin can manage all roles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isSoftwareAdmin());
      allow delete: if isSoftwareAdmin();
    }
  }
}
