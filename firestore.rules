rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to get user profile document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Role checkers
    function isSoftwareAdmin() {
      return isAuthenticated() && getUserData().role == 'software_admin';
    }
    
    function isAccountsAdmin() {
      return isAuthenticated() && (getUserData().role == 'accounts_admin' || getUserData().role == 'software_admin');
    }

    // System configuration (Firm branding, currency, report layout)
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isSoftwareAdmin();
    }

    // Cases registry: Staff can read active cases; Software Admin can create/edit/close
    match /cases/{caseId} {
      allow read: if isAuthenticated();
      allow write: if isSoftwareAdmin();
    }

    // Categories: Read by all authenticated users; modified by Software Admin
    match /categories/{catId} {
      allow read: if isAuthenticated();
      allow write: if isSoftwareAdmin();
    }

    // Court Forums: Read by all authenticated users; modified by Software Admin
    match /forums/{forumId} {
      allow read: if isAuthenticated();
      allow write: if isSoftwareAdmin();
    }

    // Expenses:
    // - Authenticated staff can create expenses and read case disbursements
    // - Accounts Admin and Software Admin can audit and update all expenses
    // - Staff can edit or delete their own expenses
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.staffId == request.auth.uid;
      allow update, delete: if isAccountsAdmin() || (isAuthenticated() && resource.data.staffId == request.auth.uid);
    }

    // Advances:
    // - Accounts Admin / Boss can disburse and settle advances
    // - Staff can read their own advances
    match /advances/{advanceId} {
      allow read: if isAuthenticated() && (isAccountsAdmin() || resource.data.staffId == request.auth.uid);
      allow write: if isAccountsAdmin();
    }

    // Users directory:
    // - Users can read and write their own basic auth profile
    // - Software Admin can modify roles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSoftwareAdmin() || request.auth.uid == userId;
    }
  }
}
